# 由 deploy_cluster.py 渲染；不用宿主机 /etc/condor，避免配置互相覆盖。
include : /etc/condor/condor_config
LOCAL_CONFIG_FILE =
LOCAL_CONFIG_DIR =
LOCAL_DIR = /var/lib/condor
LOG = $(LOCAL_DIR)/log
SPOOL = $(LOCAL_DIR)/spool
EXECUTE = $(LOCAL_DIR)/execute
LOCK = $(LOCAL_DIR)/lock
RUN = $(LOCAL_DIR)/run
# 容器不授予宿主机 cgroup 管理权限；request_* 用于调度配额。
BASE_CGROUP =
RESERVED_MEMORY = 4096
CREATE_CORE_FILES = False
CONDOR_HOST = @MANAGER_ADDRESS@
NETWORK_INTERFACE = @ADDRESS@
FULL_HOSTNAME = @NAME@
COLLECTOR_HOST = $(CONDOR_HOST):@PORT@
CONDOR_ADMIN = root@localhost
UID_DOMAIN = @UID_DOMAIN@
FILESYSTEM_DOMAIN = @NAME@
# 容器内账户 UID/GID 一致；宿主机的远端用户 UID 可以不同。
TRUST_UID_DOMAIN = True
SOFT_UID_DOMAIN = False
USE_SHARED_PORT = True
SHARED_PORT_PORT = @PORT@
UPDATE_COLLECTOR_WITH_TCP = True
WANT_UDP_COMMAND_SOCKET = False
LOWPORT = @LOWPORT@
HIGHPORT = @HIGHPORT@
IN_LOWPORT = @LOWPORT@
IN_HIGHPORT = @HIGHPORT@
SEC_DEFAULT_AUTHENTICATION = REQUIRED
SEC_DEFAULT_AUTHENTICATION_METHODS = FS, PASSWORD
SEC_CLIENT_AUTHENTICATION_METHODS = FS, PASSWORD
SEC_DEFAULT_ENCRYPTION = REQUIRED
SEC_DEFAULT_INTEGRITY = REQUIRED
SEC_PASSWORD_FILE = /etc/condor/isla-auth/pool_password
# PASSWORD 的身份是 condor_pool；FS 仅供容器本地 CLI。
ALLOW_READ = condor_pool@*, condor@$(UID_DOMAIN), @SUBMIT_USER@@$(UID_DOMAIN), root@$(UID_DOMAIN)
ALLOW_WRITE = condor_pool@*, condor@$(UID_DOMAIN), @SUBMIT_USER@@$(UID_DOMAIN), root@$(UID_DOMAIN)
ALLOW_DAEMON = condor_pool@*, condor@$(UID_DOMAIN)
ALLOW_NEGOTIATOR = condor_pool@*, condor@$(UID_DOMAIN)
ALLOW_ADVERTISE_STARTD = condor_pool@*, condor@$(UID_DOMAIN)
ALLOW_ADVERTISE_SCHEDD = condor_pool@*, condor@$(UID_DOMAIN)
ALLOW_ADVERTISE_MASTER = condor_pool@*, condor@$(UID_DOMAIN)
ALLOW_ADMINISTRATOR = root@$(UID_DOMAIN)
ALLOW_CONFIG = root@$(UID_DOMAIN)
NUM_CPUS = @CPUS@
NUM_SLOTS = 1
NUM_SLOTS_TYPE_1 = 1
SLOT_TYPE_1 = cpus=100%, memory=100%, disk=100%, swap=100%
SLOT_TYPE_1_PARTITIONABLE = True
ISLA_NODE = "@NAME@"
STARTD_ATTRS = $(STARTD_ATTRS), IslaNode
IslaNode = "@NAME@"
START = True
SUSPEND = False
PREEMPT = False
WANT_SUSPEND = False
PREEMPTION_REQUIREMENTS = False
UPDATE_INTERVAL = 15
NEGOTIATOR_INTERVAL = 10
NEGOTIATOR_CYCLE_DELAY = 2
ENABLE_PERSISTENT_CONFIG = False
@GPU_CONFIG@
