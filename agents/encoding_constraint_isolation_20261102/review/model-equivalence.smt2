; 独立验证：任意32位转换结果与任意旧flags，新overflow公式与原有有符号上下界饱和一致。
(set-logic QF_BV)
(declare-const sig (_ BitVec 32))
(declare-const flags (_ BitVec 5))
(define-fun overflow () Bool (distinct sig ((_ sign_extend 16) ((_ extract 15 0) sig))))
(define-fun limit () (_ BitVec 16) (ite (= ((_ extract 31 31) sig) #b1) #x8000 #x7fff))
(define-fun new-value () (_ BitVec 16) (ite overflow limit ((_ extract 15 0) sig)))
(define-fun new-flags () (_ BitVec 5) (ite overflow #b10000 flags))
(define-fun high () Bool (bvsgt sig #x00007fff))
(define-fun low () Bool (bvslt sig #xffff8000))
(define-fun reference-value () (_ BitVec 16) (ite high #x7fff (ite low #x8000 ((_ extract 15 0) sig))))
(define-fun reference-flags () (_ BitVec 5) (ite (or high low) #b10000 flags))
(assert (or (distinct new-value reference-value) (distinct new-flags reference-flags)))
(check-sat)
