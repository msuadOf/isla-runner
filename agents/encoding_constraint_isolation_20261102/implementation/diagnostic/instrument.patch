diff --git a/isla-lib/src/smt.rs b/isla-lib/src/smt.rs
index eb4f288..69db429 100644
--- a/isla-lib/src/smt.rs
+++ b/isla-lib/src/smt.rs
@@ -67,6 +67,45 @@ use std::path::Path;
 use std::ptr;
 use std::sync::{Arc, OnceLock};
 
+thread_local! {
+    static DIAGNOSTIC_AUX_PHASE: std::cell::Cell<bool> = std::cell::Cell::new(false);
+}
+
+pub fn diagnostic_set_aux_phase(value: bool) -> bool {
+    DIAGNOSTIC_AUX_PHASE.with(|phase| {
+        let previous = phase.get();
+        phase.set(value);
+        previous
+    })
+}
+
+pub fn diagnostic_aux_phase() -> bool {
+    DIAGNOSTIC_AUX_PHASE.with(|phase| phase.get())
+}
+
+pub fn diagnostic_timed<T, F: FnOnce() -> T>(stage: &str, f: F) -> T {
+    static NEXT_ID: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(1);
+    let id = NEXT_ID.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+    eprintln!("ENC_DIAG start id={id} stage={stage}");
+    let started = Instant::now();
+    let value = f();
+    eprintln!("ENC_DIAG end id={id} stage={stage} wall_s={:.6}", started.elapsed().as_secs_f64());
+    value
+}
+
+pub fn diagnostic_check<F: FnOnce() -> SmtResult>(stage: &str, f: F) -> SmtResult {
+    static NEXT_ID: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(1);
+    let id = NEXT_ID.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+    eprintln!("ENC_DIAG check_start id={id} stage={stage}");
+    let started = Instant::now();
+    let result = f();
+    eprintln!(
+        "ENC_DIAG check_end id={id} stage={stage} result={result:?} wall_s={:.6}",
+        started.elapsed().as_secs_f64()
+    );
+    result
+}
+
