+
+### Make求解策略
+
+直接运行 `isarch` 不传 `--tastic` 时使用 `default`。
+`scripts/run.mk` 为 `ALL` 中各 Clause 指定具体策略：非访存浮点 Clause 用 `qffp`，其余（含浮点访存）用 `qfaufbv`。
+例如 `make solve-FLEQ_S` 传 `--tastic qffp`，`make solve-LOAD` 传 `--tastic qfaufbv`；可用 `TASTIC=smt` 临时覆盖。
+
+### 本工作区的官方 Z3 链接版本
+
+`make build-isarch` 和 `make solve-*` 默认使用用户前缀
+`~/.local/opt/z3-official-1fd1d3613` 中的官方 Z3，源码提交为
+`1fd1d3613c1f34c4dff36cba3209b2234f6c6d2b`。需先将该官方构建安装到此前缀，
+或用 `make build-isarch Z3_PREFIX=/path/to/installed/z3` 指定实际安装位置。
+Make 同时设置链接搜索路径和运行时 RPATH；直接检查 `target/release/isarch --version`
+可确认实际加载版本。CLI 的默认策略和 Make 的各 Clause 策略保持独立。
diff --git a/scripts/run.mk b/scripts/run.mk
index 7cd5ead..6b040a7 100644
--- a/scripts/run.mk
+++ b/scripts/run.mk
@@ -91,8 +91,14 @@ SOLVE_CONFIG ?= ./configs/riscv64_difftest.toml
 # itrace 默认关闭；需要调试时使用 `make solve-XXX ITRACE=1` 开启。
 ITRACE ?= 0
 CARGO_ITRACE_FEATURE = $(if $(filter 1 yes true on,$(ITRACE)),--features itrace,)
-# 可选 Z3 tactic；例如 `make solve-VVTYPE TASTIC=qfaufbv`。
+# 使用官方 Z3 提交 1fd1d3613；构建和运行时均链接该版本，可用 Z3_PREFIX 覆盖。
+Z3_PREFIX ?= $(HOME)/.local/opt/z3-official-1fd1d3613
+Z3_RUSTFLAGS = -L native=$(Z3_PREFIX)/lib -C link-arg=-Wl,-rpath,$(Z3_PREFIX)/lib
+# 命令行不传 --tastic 时由 Isla 使用 default；make 为已有 Clause 写明具体策略。
+# 浮点计算使用 qffp；其余（含浮点访存）保留 qfaufbv。命令行 TASTIC=... 可覆盖。
 TASTIC ?=
+$(addprefix solve-,$(ALL)): TASTIC = qfaufbv
+$(addprefix solve-,$(filter-out $(MEMORY),$(FD_FLOAT))): TASTIC = qffp
 # 可选的独立 execution-limit TOML；VVTYPE 默认加载专用 workaround，其它 clause 不加载。
 EXECUTION_LIMITS_CONFIG ?=
 solve-VVTYPE: EXECUTION_LIMITS_CONFIG = ../sail-riscv/configs/isla/workarounds/vvtype.toml
@@ -120,7 +126,7 @@ TOTAL_FD_FLOAT=$(words $(FD_FLOAT))
 TOTAL_MEMORY=$(words $(MEMORY))
 
 build-isarch:
-	cargo build --release --bin isarch $(CARGO_ITRACE_FEATURE) $(CARGO_SMT_FEATURE)
+	RUSTFLAGS="$(RUSTFLAGS) $(Z3_RUSTFLAGS)" cargo build --release --bin isarch $(CARGO_ITRACE_FEATURE) $(CARGO_SMT_FEATURE)
 
